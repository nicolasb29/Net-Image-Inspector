{
    "manifest_version": 3,
    "name": "Capteur d'Images Réseau",
    "version": "1.4",
    "description": "Panneau latéral persistant pour capturer et afficher toutes les images réseau.",
    "permissions": [
      "webRequest",
      "tabs",
      "scripting",
      "storage",
      "sidePanel"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "action": {
      "default_title": "Ouvrir le panneau d'images"
    },
    "side_panel": {
      "default_path": "popup.html"
    },
    "background": {
      "service_worker": "background.js"
    }
  }